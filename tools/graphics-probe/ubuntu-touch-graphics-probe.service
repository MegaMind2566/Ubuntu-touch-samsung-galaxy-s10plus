[Unit]
Description=One-shot Ubuntu Touch graphics loader inspection
Wants=lxc-android-config.service
After=lxc-android-config.service
ConditionPathExists=/userdata/ubuntu-touch-graphics-probe-1/armed

[Service]
Type=simple
ExecStart=/bin/sh /userdata/ubuntu-touch-graphics-probe-1/assets/probe.sh
Restart=no
RuntimeMaxSec=150
TimeoutStopSec=3
KillMode=control-group
UMask=0077
LimitCORE=0
LimitFSIZE=1M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
