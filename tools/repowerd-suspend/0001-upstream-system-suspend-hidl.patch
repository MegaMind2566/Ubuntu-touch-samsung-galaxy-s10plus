+
+#include "hidl_system_power_control.h"
+
+#include "src/core/log.h"
+
+#include <cstdlib>
+#include <stdexcept>
+
+#include <unistd.h>
+
+namespace
+{
+char const* const log_tag = "HidlSystemPowerControl";
+
+char const* const hwbinder_dev = "/dev/hwbinder";
+char const* const suspend_iface = "android.system.suspend@1.0::ISystemSuspend";
+char const* const suspend_fqname = "android.system.suspend@1.0::ISystemSuspend/default";
+char const* const wake_lock_iface = "android.system.suspend@1.0::IWakeLock";
+
+int const wake_lock_type_partial = 0;
+
+int const suspend_transact_acquire_wake_lock = 1;
+int const wake_lock_transact_release = 1;
+}
+
+repowerd::HidlSystemPowerControl::HidlSystemPowerControl(
+    std::shared_ptr<Log> const& log)
+    : log{log},
+      sm{nullptr},
+      remote{nullptr},
+      client{nullptr},
+      wake_lock_remote{nullptr},
+      wake_lock_client{nullptr}
+{
+    if (access(hwbinder_dev, F_OK) != 0)
+        throw std::runtime_error{"No hwbinder interface available"};
+
+    sm = gbinder_servicemanager_new(hwbinder_dev);
+    if (!sm)
+        throw std::runtime_error{"Failed to connect to hwservicemanager"};
+
+    remote = gbinder_servicemanager_get_service_sync(sm, suspend_fqname, nullptr);
+    if (!remote)
+    {
+        gbinder_servicemanager_unref(sm);
+        sm = nullptr;
+        throw std::runtime_error{"SystemSuspend service not available"};
+    }
+
+    client = gbinder_client_new(remote, suspend_iface);
+    if (!client)
+    {
+        gbinder_remote_object_unref(remote);
+        gbinder_servicemanager_unref(sm);
+        remote = nullptr;
+        sm = nullptr;
+        throw std::runtime_error{"Failed to create SystemSuspend client"};
+    }
+
+    log->logDebug(log_tag, "Initialized using %s", suspend_fqname);
+}
+
+repowerd::HidlSystemPowerControl::~HidlSystemPowerControl()
+{
+    release_wake_lock();
+
+    if (client)
+        gbinder_client_unref(client);
+    if (remote)
+        gbinder_remote_object_unref(remote);
+    if (sm)
+        gbinder_servicemanager_unref(sm);
+}
+
+void repowerd::HidlSystemPowerControl::acquire_wake_lock()
+{
+    if (wake_lock_client)
+        return;
+
+    int status = -1;
+    GBinderLocalRequest* req = gbinder_client_new_request(client);
+    GBinderWriter writer;
+
+    gbinder_local_request_init_writer(req, &writer);
+    gbinder_writer_append_int32(&writer, wake_lock_type_partial);
+    gbinder_writer_append_hidl_string(&writer, "repowerd");
+
+    GBinderRemoteReply* reply = gbinder_client_transact_sync_reply(
+        client, suspend_transact_acquire_wake_lock, req, &status);
+
+    if (reply)
+    {
+        GBinderReader reader;
+        gbinder_remote_reply_init_reader(reply, &reader);
+        gbinder_reader_read_int32(&reader, nullptr);
+        wake_lock_remote = gbinder_reader_read_object(&reader);
+        gbinder_remote_reply_unref(reply);
+    }
+
+    gbinder_local_request_unref(req);
+
+    if (wake_lock_remote)
+        wake_lock_client = gbinder_client_new(wake_lock_remote, wake_lock_iface);
+
+    if (!wake_lock_client)
+        log->logWarning(log_tag, "Failed to acquire wake lock (status %d)", status);
+}
+
+void repowerd::HidlSystemPowerControl::release_wake_lock()
+{
+    if (!wake_lock_client)
+        return;
+
+    GBinderLocalRequest* req = gbinder_client_new_request(wake_lock_client);
+    gbinder_client_transact_sync_oneway(wake_lock_client, wake_lock_transact_release, req);
+    gbinder_local_request_unref(req);
+
+    gbinder_client_unref(wake_lock_client);
+    gbinder_remote_object_unref(wake_lock_remote);
+    wake_lock_client = nullptr;
+    wake_lock_remote = nullptr;
+}
+
+void repowerd::HidlSystemPowerControl::start_processing()
+{
+}
+
+repowerd::HandlerRegistration
+repowerd::HidlSystemPowerControl::register_system_resume_handler(
+    SystemResumeHandler const&)
+{
+    return HandlerRegistration{};
+}
+
+repowerd::HandlerRegistration
+repowerd::HidlSystemPowerControl::register_system_allow_suspend_handler(
+    SystemAllowSuspendHandler const&)
+{
+    return HandlerRegistration{};
+}
+
+repowerd::HandlerRegistration
+repowerd::HidlSystemPowerControl::register_system_disallow_suspend_handler(
+    SystemDisallowSuspendHandler const&)
+{
+    return HandlerRegistration{};
+}
+
+void repowerd::HidlSystemPowerControl::allow_automatic_suspend(
+    std::string const& id)
+{
+    std::lock_guard<std::mutex> lock{suspend_mutex};
+
+    log->logDebug(log_tag, "allow_suspend(%s)", id.c_str());
+
+    if (suspend_disallowances.erase(id) > 0 &&
+        suspend_disallowances.empty())
+    {
+        log->logDebug(log_tag, "Releasing wake lock");
+        release_wake_lock();
+    }
+}
+
+void repowerd::HidlSystemPowerControl::disallow_automatic_suspend(
+    std::string const& id)
+{
+    std::lock_guard<std::mutex> lock{suspend_mutex};
+
+    log->logDebug(log_tag, "disallow_suspend(%s)", id.c_str());
+
+    auto const could_be_suspended = suspend_disallowances.empty();
+
+    suspend_disallowances.insert(id);
+
+    if (could_be_suspended)
+    {
+        log->logDebug(log_tag, "Acquiring wake lock");
+        acquire_wake_lock();
+    }
+}
+
+void repowerd::HidlSystemPowerControl::power_off()
+{
+    log->logDebug(log_tag, "power_off()");
+
+    if (system("shutdown -P now")) {}
+}
+
+void repowerd::HidlSystemPowerControl::suspend()
+{
+}
+
+void repowerd::HidlSystemPowerControl::allow_default_system_handlers()
+{
+}
+
+void repowerd::HidlSystemPowerControl::disallow_default_system_handlers()
+{
+}
