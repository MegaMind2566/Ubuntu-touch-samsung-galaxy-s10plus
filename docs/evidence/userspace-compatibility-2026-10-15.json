    "source_findings": [
      {
        "url": "https://github.com/aosp-mirror/platform_system_core/blob/android-12.1.0_r27/libprocessgroup/setup/cgroup_map_write.cpp",
        "git_blob": "3121d244b45550c1015c6110d5e83e2458dc19a2",
        "functions": [
          "SetupCgroup",
          "CgroupSetup"
        ],
        "finding": "SetupCgroup returns false when a required controller mount fails. CgroupSetup logs a warning for that descriptor and continues with other controllers, then writes its descriptor map. A missing individual blkio controller does not itself make CgroupSetup fail."
      },
      {
        "url": "https://github.com/aosp-mirror/platform_system_core/blob/android-12.1.0_r27/init/init.cpp",
        "git_blob": "942feb9395b6a9aa8daeb05dc6218216a126b453",
        "function": "SetupCgroupsAction",
        "finding": "The queued init action only returns a cgroup setup error if the overall CgroupSetup call fails; individual controller failures are handled internally as above."
      },
      {
        "url": "https://github.com/aosp-mirror/platform_system_core/blob/android-12.1.0_r27/init/service.cpp",
        "git_blob": "c3069f5b2b59bcb0051fea5f8877dfc11fbb5967",
        "finding": "A SetTaskProfiles failure in the service child logs an error and continues to process attributes and exec. It is not an unconditional abort of the HAL executable."
      }
    ],
