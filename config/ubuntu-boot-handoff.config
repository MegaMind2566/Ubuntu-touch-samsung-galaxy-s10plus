# BOOT 6: run the instrumented original Ubuntu initramfs through the tested path.
CONFIG_INITRAMFS_SOURCE="@UT_UBUNTU_CPIO@"
CONFIG_INITRAMFS_FORCE=y
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# Samsung may supply its own bootloader arguments. Put compatibility flags in
# the built-in extended command line as well as the BOOT header.
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs console=tty0 systempart=/dev/disk/by-partlabel/system systemd.unified_cgroup_hierarchy=0 systemd.log_target=kmsg systemd.log_level=debug systemd.show_status=1"
